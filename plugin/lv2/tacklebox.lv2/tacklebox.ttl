@prefix doap:  <http://usefulinc.com/ns/doap#> .
@prefix lv2:   <http://lv2plug.in/ns/lv2core#> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix units: <http://lv2plug.in/ns/extensions/units#> .
<http://dfdx.eu/lv2/tacklebox>
    a lv2:Plugin ;
  lv2:project <http://lv2plug.in/ns/lv2> ;
  doap:name "TackleboxModeling" ;
  doap:license <http://opensource.org/licenses/isc> ;
  lv2:optionalFeature lv2:hardRTCapable ;
  lv2:port [
    a lv2:InputPort , lv2:ControlPort ;
    lv2:index 0 ;
    lv2:symbol "pre_gain" ;
    lv2:name "Pre Gain" ;
    lv2:default 0.0 ;
    lv2:minimum -90.0 ;
    lv2:maximum 24.0 ;
    units:unit units:db ;
  ] , [
    a lv2:InputPort , lv2:ControlPort ;
    lv2:index 1 ;
    lv2:symbol "post_gain" ;
    lv2:name "Post Gain" ;
    lv2:default 0.0 ;
    lv2:minimum -90.0 ;
    lv2:maximum 24.0 ;
    units:unit units:db ;
  ] , [
    a lv2:AudioPort , lv2:InputPort ;
    lv2:index 2 ;
    lv2:symbol "in" ;
    lv2:name "In"
  ] , [
    a lv2:AudioPort , lv2:OutputPort ;
    lv2:index 3 ;
    lv2:symbol "out" ;
    lv2:name "Out"
  ] , [
    a lv2:InputPort , lv2:ControlPort ;
    lv2:index 4 ;
    lv2:symbol "model" ;
    lv2:name "Model" ;
    lv2:default 0.0 ;
    lv2:minimum 0.0 ;
    lv2:maximum 4.0 ;
    lv2:portProperty lv2:enumeration ;
    lv2:scalePoint [
      rdfs:label "Fender Deluxe Reverb" ; rdf:value 0.0
    ], [
      rdfs:label "Marshall Bluesbreaker 1962" ; rdf:value 1.0
    ], [
      rdfs:label "BrianMay" ; rdf:value 2.0
    ], [
      rdfs:label "EVH 5150" ; rdf:value 3.0
    ], [
      rdfs:label "VOX AC30 TOP BOOST Greenback" ; rdf:value 4.0
    ]

  ] , [
    a lv2:InputPort , lv2:ControlPort ;
    lv2:index 5 ;
    lv2:symbol "oversampling" ;
    lv2:name "Oversampling (non-linearity)" ;
    lv2:default 0.0 ;
    lv2:minimum 0.0 ;
    lv2:maximum 1.0 ;
    lv2:portProperty lv2:enumeration ;
    lv2:scalePoint [
      rdfs:label "Off" ; rdf:value 0.0
    ], [
      rdfs:label "2x" ; rdf:value 1.0
    ]
  ] , [
    a lv2:InputPort , lv2:ControlPort ;
    lv2:index 6 ;
    lv2:symbol "stage_to_process" ;
    lv2:name "Stage(s) to process" ;
    lv2:default 0.0 ;
    lv2:minimum 0.0 ;
    lv2:maximum 5.0 ;
    lv2:portProperty lv2:enumeration ;
    lv2:scalePoint [
      rdfs:label "All stages"; rdf:value 0.0
    ], [
      rdfs:label "Stage 1" ; rdf:value 1.0
    ], [
      rdfs:label "Stage 2" ; rdf:value 2.0
    ], [
      rdfs:label "Stage 3" ; rdf:value 3.0
    ], [
      rdfs:label "Stage 4" ; rdf:value 4.0
    ], [
      rdfs:label "Stage 5" ; rdf:value 5.0
    ]
  ] .
